{
    "name": "europolis/api",
    "description": "Europolis - REST API pentru jocul de societate",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "slim/slim": "^4.12",
        "slim/psr7": "^1.6",
        "php-di/php-di": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "behat/behat": "^3.31"
    },
    "autoload": {
        "psr-4": {
            "Europolis\\": "src/"
        }
    },
    "scripts": {
        "start": "php -S localhost:8080 -t public"
    }
}
